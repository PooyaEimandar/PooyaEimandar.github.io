**/.DS_Store

# Local build and dependency output
/node_modules/
/target/
/_site/

# Ignore outputs left over from builds before _site became the build directory.
/pkg/
/app.js
/app.js.map

# The portrait photograph is a private, build-time-only KTX conversion input.
# The only JPEGs that belong in this repository are the page images in
# assets/images; CI refuses one committed anywhere else.
*.jpg
*.jpeg
!/assets/images/*.jpg

# Local texture-pipeline caches and authoring files
**/__pycache__/
*.py[cod]
*.blend
*.blend1
